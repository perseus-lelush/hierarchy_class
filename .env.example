# Hierarchy Class environment template
# Copy to .env.local and fill in the values.

# Public client config (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED in production. The public origin of the deployment (no trailing
# slash), e.g. https://your-production-domain. Used as the base for email
# confirmation links and password recovery redirects. Without it, signup
# email confirmation cannot work in production.
NEXT_PUBLIC_SITE_URL=

# Server-only. Required for permanent account deletion (auth admin + storage
# cleanup) and the signup duplicate-identifier pre-check. NEVER expose this to
# the browser - do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only email (Resend REST API - no SDK needed).
# Used by the feedback route and the account-restriction notice.
RESEND_API_KEY=
# Feedback delivery address - the inbox that receives user feedback emails.
FEEDBACK_INBOX=
# Optional sender override, e.g. "Hierarchy Class <noreply@yourdomain.com>".
# Falls back to Resend's onboarding sandbox when unset.
FEEDBACK_FROM_EMAIL=

# Server-only, cross-instance rate limiting (lib/server/rateLimit.ts).
# Required in production for the signup / resend-confirmation / resolve-music
# limits. Without them the limiters fail OPEN (requests allowed) and an error
# is logged - do not deploy without them. Create a database in the Upstash
# console and copy the REST API credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only PayMongo keys for the GCash Florin top-up (lib/paymongo.ts).
# Secret API key from Dashboard -> Developers (sk_test_xxx / sk_live_xxx).
PAYMONGO_SECRET_KEY=
# Signing secret of the webhook endpoint that receives
# checkout_session.payment.paid events - shown once when creating the webhook.
PAYMONGO_WEBHOOK_SECRET=
